{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": { "browser": true, "es2024": true },
  "plugins": ["react", "oxc"],
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "warn",
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["supabase/functions/**/*.ts"],
      "env": { "browser": false },
      "rules": { "no-undef": "off" }
    },
    {
      "files": ["api/**/*.js", "*.mjs"],
      "env": { "node": true }
    }
  ]
}
