# react-snap 1.23 depends on puppeteer ^1.8, whose postinstall downloads a
# Chromium 71 build from a 2019 storage bucket. That binary is useless to us -
# it predates optional chaining and nullish coalescing, so it throws a
# SyntaxError on the Vite bundle and snapshots an empty page - and a dead
# download URL would fail `npm install` outright on a CI/Vercel build. Skip it;
# scripts/prerender.mjs drives Playwright's pinned Chromium (or a system Chrome)
# instead.
puppeteer_skip_chromium_download=true
